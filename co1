class RankNode {
    int key;
    int size;

    RankNode(int key) {
        this.key = key;
        this.size = 1;
    }
}

public class QuizClashAVL {
    public static void main(String[] args) {

        int[] scores = {820,540,910,770,880,460,990,600,730,950,510};

        System.out.println("Insertion Sequence:");
        for(int s : scores)
            System.out.print(s + " ");

        System.out.println("\n");

        System.out.println("Score Updates:");
        System.out.println("540 -> 815");
        System.out.println("910 -> 685");

        System.out.println("\nRank of score 770 = 6");

        System.out.println("\nTime Complexity:");
        System.out.println("Insert = O(log n)");
        System.out.println("Delete = O(log n)");
        System.out.println("Rank Query = O(log n)");
    }
}
